{
  "productName": "AgentLens",
  "version": "0.2.1",
  "identifier": "dev.agentlens.desktop",
  "build": { "frontendDist": "ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "title": "AgentLens", "width": 1280, "height": 800, "minWidth": 700, "minHeight": 460 }],
    "security": { "csp": "default-src 'self'; img-src 'self'; style-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": { "active": true, "targets": ["app"], "icon": ["icons/icon.png", "icons/icon.icns"] }
}
